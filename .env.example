BRIDGE_ENVIRONMENT=development
BRIDGE_DATABASE_URL=postgresql+asyncpg://bridge:bridge@localhost:5432/pizzburg_bridge
BRIDGE_AUTO_CREATE_SCHEMA=false

# Only local placeholders. Replace them outside Git before any shared deployment.
BRIDGE_OAUTH_CLIENT_ID=local-yandex-client
BRIDGE_OAUTH_CLIENT_SECRET=change-me-local-client-secret
BRIDGE_JWT_SECRET=change-me-local-jwt-signing-secret-at-least-32-chars
BRIDGE_TOKEN_TTL_SECONDS=900

# Read-only API token of the main Pizzburg Poster account.
BRIDGE_POSTER_MAIN_TOKEN=
BRIDGE_POSTER_MENU_CATEGORY_ID=3
BRIDGE_POSTER_MAIN_SPOT_ID=1
BRIDGE_POSTER_MENU_PRICE_SOURCE=Wolt
